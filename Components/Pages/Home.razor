@page "/home"

<div class="page-container">

    <h1 class="home-title">
        Acogida 2.0
    </h1>

    <div class="cards-grid">

        <div class="card menu-card">
            <img src="icons/alimentacion.png" alt="Alimentación" />
            <h3>Alimentación</h3>
        </div>

        <div class="card menu-card">
            <img src="icons/salud.png" alt="Salud" />
            <h3>Salud</h3>
        </div>

        <div class="card menu-card">
            <img src="icons/transporte.png" alt="Transporte" />
            <h3>Transporte</h3>
        </div>

        <div class="card menu-card">
            <img src="icons/aprendizaje.png" alt="Aprendizaje" />
            <h3>Aprendizaje</h3>
        </div>

    </div>

    <div class="card ayuda-card">

        <img src="icons/mano-mundo.png"
             alt="Ayuda y Recursos"
             class="ayuda-icon" />

        <div>
            <h2>Ayuda y Recursos</h2>

            <p>
                Información y acceso a recursos sociales,
                documentación, orientación y apoyo.
            </p>
        </div>

    </div>

</div>